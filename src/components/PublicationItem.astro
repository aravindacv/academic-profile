---
import { ext, isSelf, typeLabels, type Publication } from '../lib/site';

interface Props {
  pub: Publication;
  showType?: boolean;
}
const { pub, showType = true } = Astro.props;
const link = pub.doi ? `https://doi.org/${pub.doi}` : pub.url;
const statusLabel = pub.status === 'published' ? null : pub.status === 'accepted' ? 'Accepted' : 'In press';
const searchText = [pub.title, pub.venue, pub.authors.join(' '), pub.tags.join(' '), String(pub.year)].join(' ').toLowerCase();
---
<li class="pub" data-type={pub.type} data-search={searchText}>
  <h3 class="pub-title">{link ? <a href={link} {...ext}>{pub.title}</a> : pub.title}</h3>
  <p class="pub-authors">
    {pub.authors.map((a, i) => (
      <>{i > 0 && (i === pub.authors.length - 1 && a !== 'et al.' ? ' & ' : ', ')}<span class={isSelf(a) ? 'self' : undefined}>{a}</span></>
    ))}
  </p>
  <p class="pub-venue">
    {pub.year}{pub.type === 'book' ? ', ' : ', In: '}<i>{pub.venue}</i>{pub.details && `, ${pub.details}`}{pub.publisher && pub.type !== 'book' && ` (${pub.publisher})`}.
  </p>
  <div class="pub-meta">
    {statusLabel && <span class="badge">{statusLabel}</span>}
    {showType && <span class="badge badge--type">{typeLabels[pub.type]}</span>}
    {pub.doi && <span>DOI: <a href={`https://doi.org/${pub.doi}`} {...ext}>{pub.doi}</a></span>}
    {!pub.doi && pub.url && <a href={pub.url} {...ext}>View ↗</a>}
    {pub.doi && (
      <span
        class="__dimensions_badge_embed__ dim-badge"
        data-doi={pub.doi}
        data-style="small_rectangle"
        data-legend="hover-right"
        data-hide-zero-citations="true"
      ></span>
    )}
  </div>
</li>
